int threshold = 3;

float average(int a[], int n) {
    int i = 0;
    int sum = 0;
    float result;

    while (i < n) {
        sum = sum + a[i];
        i = i + 1;
    }

    result = sum;
    return result / n;
}

int main() {
    int a[5];
    int i = 0;
    float avg;

    while (i < 5) {
        a[i] = getint();
        i = i + 1;
    }

    avg = average(a, 5);
    putfloat(avg);
    putch(10);

    if (avg >= threshold) {
        putint(1);
    } else {
        putint(0);
    }
    putch(10);

    return 0;
}
